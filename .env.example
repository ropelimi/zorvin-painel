# Variaveis do painel (Vite).
#
# ATENCAO: o Vite grava estes valores DENTRO do arquivo final, no momento do
# build. Ou seja: preencher na Render nao muda nada sozinho — depois de mexer
# em qualquer VITE_*, e preciso publicar o painel de novo.
#
# Localmente: copie este arquivo para .env (ele ja esta no .gitignore).
# Na Render: Dashboard > zorvin-painel > Environment.

# Banco/login do Zorvin.
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=cole-aqui-a-chave-anon

# Endereco do zorvin-bridge (o servidor que fala com a Uazapi e com o Vantoro).
# Sem barra no final. E a ponte quem guarda o token do Vantoro — o painel
# nunca ve esse token.
VITE_BRIDGE_URL=https://zorvin-bridge-xxxx.onrender.com

# Endereco do Vantoro no navegador, usado so no link "Abrir ficha completa".
# Opcional: sem ele o link simplesmente nao aparece.
VITE_VANTORO_WEB=https://app.vantoro.com.br
